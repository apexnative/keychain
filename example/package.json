{
  "name": "@apexnative/keychain-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "../scripts/android-env.sh react-native run-android --active-arch-only",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "pods": "cd ios && bundle install && bundle exec pod install",
    "typecheck": "tsc --noEmit",
    "build:android": "../scripts/android-env.sh react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a -PapexKeychainWarningsAsErrors\"",
    "build:ios": "node ../scripts/ios-warnings.mjs xcodebuild -workspace ios/KeychainExample.xcworkspace -scheme KeychainExample -configuration Debug -sdk iphonesimulator -destination \"generic/platform=iOS Simulator\" COMPILER_INDEX_STORE_ENABLE=NO build"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.2.0",
    "react-native-builder-bob": "^0.43.1",
    "react-native-monorepo-config": "^0.4.0"
  },
  "engines": {
    "node": ">= 22.13.0"
  }
}

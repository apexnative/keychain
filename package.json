{
  "name": "@apexnative/keychain",
  "version": "1.0.0-rc.2",
  "description": "Secure storage for React Native: the iOS Keychain and the Android Keystore behind one API",
  "keywords": [
    "react-native",
    "keychain",
    "keystore",
    "secure-storage",
    "biometrics",
    "ios",
    "android"
  ],
  "homepage": "https://github.com/apexnative/keychain#readme",
  "bugs": {
    "url": "https://github.com/apexnative/keychain/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apexnative/keychain.git"
  },
  "license": "MIT",
  "author": "Artashes Bayazetyan (https://github.com/bayazetyan)",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/module/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "apexnative-keychain-source": "./src/index.ts",
      "types": "./lib/typescript/module/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./jest": {
      "apexnative-keychain-source": "./src/jest/index.ts",
      "types": "./lib/typescript/commonjs/jest/index.d.ts",
      "default": "./lib/commonjs/jest/index.js"
    },
    "./migrate": {
      "apexnative-keychain-source": "./src/migrate/index.ts",
      "types": "./lib/typescript/module/migrate/index.d.ts",
      "default": "./lib/module/migrate/index.js"
    },
    "./compat": {
      "apexnative-keychain-source": "./src/compat/index.ts",
      "types": "./lib/typescript/module/compat/index.d.ts",
      "default": "./lib/module/compat/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "app.plugin.js",
    "plugin",
    "android",
    "ios",
    "CHANGELOG.md",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/__snapshots__",
    "!**/*.test.*",
    "!android/src/test",
    "!android/src/androidTest",
    "!ios/Tests",
    "!ios/TestHost",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @apexnative/keychain-example",
    "check:headers": "node scripts/check-license-headers.mjs",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build --target module && bob build --target commonjs && bob build --target typescript && tsc -p plugin/tsconfig.build.json",
    "typecheck": "tsc && tsc -p plugin && yarn example typecheck",
    "lint": "eslint \"**/*.{js,mjs,ts,tsx}\"",
    "test": "jest"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "58.0.9",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.43.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "dependenciesMeta": {
    "lefthook": {
      "built": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "codegenConfig": {
    "name": "ApexKeychainSpec",
    "type": "modules",
    "jsSrcsDir": "./src/native",
    "android": {
      "javaPackageName": "dev.apexnative.keychain"
    },
    "ios": {
      "modulesProvider": {
        "ApexKeychain": "ANKKeychainModule"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "commonjs",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook"
    ],
    "version": "0.63.1"
  }
}

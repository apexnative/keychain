{
  "expo": {
    "name": "KeychainExpo",
    "slug": "apexnative-keychain-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.apexnative.keychain.expo",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.apexnative.keychain.expo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "@apexnative/keychain",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock your secrets with Face ID.",
          "clearOnReinstall": true
        }
      ]
    ]
  }
}
